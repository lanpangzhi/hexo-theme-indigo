<% if (theme.live2d && theme.live2d.enable) { %>
<script src="<%- url_for('/live2dw/lib/L2Dwidget.min.js') %>"></script>
<script>
L2Dwidget.init({
  model: { jsonPath: '<%- url_for('/live2dw/assets/koharu.model.json') %>' },
  display: {
    position: '<%- theme.live2d.display.position %>',
    width: <%- theme.live2d.display.width %>,
    height: <%- theme.live2d.display.height %>
  },
  mobile: { show: <%- theme.live2d.mobile.show %> },
  react: {
    opacityDefault: <%- theme.live2d.react.opacityDefault %>,
    opacityOnHover: <%- theme.live2d.react.opacityOnHover %>
  }
});
</script>
<% } %>
