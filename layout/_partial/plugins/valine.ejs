<% if (theme.valine.enable ){ %>
    <!-- Valine Comments -->
    <div class="comments vcomment" id="comments"></div>
    <script src="<%- url_for(theme_js('/js/waline', cache)) %>"></script>
    <!-- Valine Comments script -->
    <script>
        Waline({
            el: '#comments',
            serverURL: 'https://waline.langpz.com',
        });
    </script>
    <!-- Valine Comments end -->
<% } %>
