<% if (theme.valine.enable ){ %>
    <!-- Valine Comments -->
    <div class="comments vcomment" id="comments"></div>
    <script src="//cdn.jsdelivr.net/npm/@waline/client"></script>
    <!-- Valine Comments script -->
    <script>
        Waline({
            el: '#comments',
            serverURL: 'https://blog-api-coral.vercel.app',
        });
    </script>
    <!-- Valine Comments end -->
<% } %>
